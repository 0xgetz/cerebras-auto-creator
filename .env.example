# Copy to .env and fill what you need. All are optional.

# Run the browser invisibly (true) or visibly (false) for debugging.
HEADLESS=true

# Where account JSON/CSV files are written.
OUT_DIR=outputs

# Max time to wait for the Cerebras sign-in email (ms).
MAIL_TIMEOUT_MS=180000

# Override the generated identity (leave blank for random).
# CEREBRAS_FULL_NAME=Olivia Martin
# CEREBRAS_COMPANY=Cedar Digital
# CEREBRAS_KEY_NAME=my-key

# Payment card — ONLY set these if you are authorized to use this card.
# Cerebras blocks API-key creation until a card is saved. With these set, the
# script fills the Stripe form for you, then creates the key.
# CARD_NUMBER=4242424242424242
# CARD_EXP=12/34
# CARD_CVC=123
# CARD_ZIP=12345
